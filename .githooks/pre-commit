#!/usr/bin/env bash
set -euo pipefail

staged() { git diff --cached --name-only; }

# When uv.lock is part of the commit, regenerate the modal_requirements.txt
# files and stage them so they stay in sync with the lockfile.
if staged | grep -qx 'uv\.lock'; then
    echo "[pre-commit] uv.lock changed — regenerating modal_requirements.txt files"
    ./tools/regen_modal_reqs.sh
    git add packages/training/modal_requirements.txt
fi

